{
  "format": "traceworks-workflow",
  "format_version": 1,
  "id": "b1445bda-e182-479a-bf85-f5b519d68ad2",
  "name": "Hello",
  "description": "A small workflow that greets, counts the files in the workspace, asks for approval and says it is done.",
  "default_context": {"name": "world"},
  "metadata": {"gate": {"expected": true}},
  "blocks": [
    {
      "type": "shell",
      "name": "greet",
      "config": {"command": "echo \"Hello, {{ name }}\""}
    },
    {
      "type": "shell",
      "name": "count",
      "config": {"command": "bash \"{{ package_dir }}/scripts/count-files.sh\""}
    },
    {
      "type": "approval",
      "name": "publish",
      "config": {"question": "Publish the greeting \"{{ block.greet.output }}\"?", "options": ["Yes", "No"]}
    },
    {
      "type": "shell",
      "name": "done",
      "config": {"command": "echo Published: {{ block.greet.output }}"}
    }
  ]
}

# The rules of the testing self-audit: where the sources are, what counts as a finding, which classes the AI judges.
# One `name value ...` per line; a name may occur several times where the README says so. The scripts hold no
# threshold of their own.

# ---- Where the sources are --------------------------------------------------------------------------------------
# Directory patterns below the workspace: `*` is one directory name or a part of it, `**` any directories.
# A Java file in none of them is named as NOT MEASURED.
main_root    **/src/main/java
# The tools the self-audit packages and the egress image build into their images; their tests are Maven modules.
main_root    examples/self-audit/*/images/*/src
main_root    images/*/src
test_root    **/src/test/java
# Never entered, like every directory whose name starts with a dot.
skip_dir     target build node_modules

# ---- class-without-test -----------------------------------------------------------------------------------------
# A top-level type of the main sources is a finding when it has at least this many lines of code (lines that hold
# anything besides blanks and comments) and at least this many branches (if, for, while, case, catch, ?:, && and ||),
# and no test covers it by name: no type of the test sources is called <Name><test_suffix>, and no file of the test
# sources names <Name> in its code. Both thresholds keep records, exceptions and small value types out.
class_min_ncloc      60
class_min_branches   8
test_suffix          Test IT Tests

# ---- test-without-assertion -------------------------------------------------------------------------------------
# A method with one of these annotations is a test.
test_annotation      Test ParameterizedTest RepeatedTest TestFactory TestTemplate
# A test asserts when its body calls a method whose whole name matches one of these regular expressions, or calls a
# helper of the test sources that does.
assertion_call       assert\w* verify\w* fail expect\w*

# ---- disabled-test ----------------------------------------------------------------------------------------------
disabled_annotation  Disabled
assumption_call      assume\w* assumingThat
# Whether a test that skips itself on an assumption is a finding ("finding") or only counted ("fact"). Here it is a
# fact: the tests that need a container runtime skip without one on purpose, and the CI's integration job runs them
# where a missing runtime fails the suite. As findings they were 19 of 41 in the first run, and none was a defect.
assumption_report    fact

# ---- command-without-integration-test ---------------------------------------------------------------------------
# A command is declared where this regular expression matches below command_sources; its group 1 is the name.
command_sources      traceworks-cli/src/main/java
command_declared     Spec\.of\(\s*"([a-z][a-z0-9-]*)"
# An integration test runs a command when a call of one of these methods below command_tests has the command's name
# as its first string argument: exec("verify", id).
command_tests        integration-tests/src/test/java
command_runner       exec

# ---- The classes the AI judges ----------------------------------------------------------------------------------
# A class with at least one test file and at least candidate_min_ncloc lines of code is eligible: an item of the
# audit. Its score is (lines of code + score_per_branch * branches) * the weight of its layer. A run judges at most
# candidates_max of them: not the ones the register calls clean or decided and that have not changed since, first
# the ones that changed or were never judged, by score, then the ones with an open finding. The rest that need a
# verdict are named as cut, and get their place in a later run.
candidates_max       30
# The version of the question the AI is asked. It is part of every item's digest: raise it when the prompt or the
# instructions change what counts as a finding, and every class is judged again.
verdict_version      1
candidate_min_ncloc  80
score_per_branch     4
# The code of a class reaches the prompt up to this many lines; the AI reads the rest of a longer file itself.
max_code_lines       700
# How many test files of a class the prompt names.
max_tests_listed     6
# What the report accepts from one answer.
max_findings_per_class 3

# `layer <weight> <package or class>`: the longest prefix that names the class counts; every other class weighs 1.
# First where a missed bug costs most: the engine, the record, the container arguments and the redaction.
layer 3 traceworks.core.engine
layer 3 traceworks.core.record
layer 3 traceworks.core.container
layer 3 traceworks.adapters.container
layer 3 traceworks.adapters.record
layer 2 traceworks.core.blocks
layer 2 traceworks.core.register
layer 2 traceworks.core.context
layer 2 traceworks.adapters.host
layer 2 traceworks.adapters.pkg
layer 2 traceworks.egress
# The tools of the self-audit packages check Traceworks; they are not what Traceworks guarantees.
layer 0.5 traceworks.selfaudit

# ---- Severities -------------------------------------------------------------------------------------------------
# What the envelope states for the measured findings; catalog.json allows the same range. An uncaught mutation has
# the severity its verdict gives it (LOW, MEDIUM or HIGH).
severity class-without-test                 MEDIUM
severity class-without-test-outside-layers  LOW
severity test-without-assertion             MEDIUM
severity disabled-test                      LOW
severity command-without-integration-test   MEDIUM

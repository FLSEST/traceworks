{
  "format": "traceworks-workflow",
  "format_version": 1,
  "id": "fa2ffd2d-d373-4ec5-b89a-ad05c5b72d3d",
  "name": "IT ai-marker",
  "description": "A simple AI step for Claude and one for Pi, both with the input prompt, which names the fake CLI's behaviour by a marker; a failed step does not stop the run.",
  "default_context": {
    "prompt": "plain"
  },
  "blocks": [
    {
      "type": "simple",
      "name": "claude",
      "config": {
        "command": "{{ prompt }}",
        "on_failure": "continue"
      }
    },
    {
      "type": "simple",
      "name": "pi",
      "config": {
        "command": "{{ prompt }}",
        "provider": "PI",
        "on_failure": "continue"
      }
    }
  ]
}

{
  "format": "traceworks-workflow",
  "formatVersion": 1,
  "id": "897709a6-8fd1-40e4-9996-64b211fd90d0",
  "name": "IT approval",
  "description": "A shell step, an approval that parks the run and fails it on a rejection, and a shell step after it.",
  "blocks": [
    {
      "type": "shell",
      "name": "prepare",
      "config": {"command": "echo prepared"}
    },
    {
      "type": "approval",
      "name": "release",
      "config": {"question": "Release {{ block.prepare.output }}?", "options": ["Yes", "No"], "on_no": "fail"}
    },
    {
      "type": "shell",
      "name": "released",
      "config": {"command": "echo released after {{ approval_answer }}"}
    }
  ]
}

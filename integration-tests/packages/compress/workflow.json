{
  "format": "traceworks-workflow",
  "formatVersion": 1,
  "id": "717c4550-6e2a-464a-af36-c4810d457452",
  "name": "IT compress",
  "description": "The deterministic compress block keeps one error line of a log, and the next step reads the compressed text.",
  "blocks": [
    {
      "type": "shell",
      "name": "log",
      "config": {"command": "printf 'INFO start\\nERROR disk full\\nINFO retry\\nERROR disk still full\\nINFO done\\n'"}
    },
    {
      "type": "compress",
      "name": "errors",
      "config": {"source": "log", "stages": [{"op": "lines.filter", "include": ["^ERROR"], "exclude": ["still"]}]}
    },
    {
      "type": "shell",
      "name": "count",
      "config": {"command": "printf '%s\\n' {{ block.errors.output }} | grep -c '^ERROR'", "shell_escape_variables": true}
    }
  ]
}

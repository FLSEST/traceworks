{
  "format": "traceworks-workflow",
  "format_version": 1,
  "id": "033263ce-94ef-4480-9a41-ee5bd21f9ab7",
  "name": "IT children",
  "description": "A sub-workflow and a foreach with workflow_id run the child workflow in child/ as child runs.",
  "default_context": {"who": "parent"},
  "blocks": [
    {
      "type": "sub-workflow",
      "name": "once",
      "config": {"workflow_id": "./child"}
    },
    {
      "type": "foreach",
      "name": "per_item",
      "config": {
        "workflow_id": "./child",
        "items": ["red", "green"],
        "variable_name": "colour",
        "context": {"who": "item {{ colour }}"}
      }
    },
    {
      "type": "shell",
      "name": "after",
      "config": {"command": "echo after: {{ block.once.output }}"}
    }
  ]
}

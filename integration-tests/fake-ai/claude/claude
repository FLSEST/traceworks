#!/bin/sh
# A fake `claude -p --output-format stream-json`: it answers in the stream format ClaudeStream reads, with no model.
# What it does is picked by markers like [fake:NAME] or [fake:NAME=VALUE] in the prompt on stdin, in the system prompt
# file, or in both; see integration-tests/README.md. Without a marker it answers with what it was given (arguments,
# the names of the credential-like variables, a hash of each credential's value, the prompt), so a test sees exactly
# what the adapter handed the CLI. It prints no credential's value except for [fake:print-credential].
set -u

args=""
reason=no
prev=""
for a in "$@"; do
  args="$args [$a]"
  [ "$a" = "--max-turns" ] && reason=yes
  prev="$a"
done

prompt=$(cat)
system=""
[ -f /tmp/traceworks-system-prompt ] && system=$(cat /tmp/traceworks-system-prompt)
all="$prompt
$system"

# Escapes text as the inside of a JSON string: backslash, quote, newlines and tabs.
json() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
}

# The value of a marker [fake:NAME=VALUE] in the prompt and system prompt; empty when absent.
marker_value() {
  printf '%s\n' "$all" | sed -n "s/.*\[fake:$1=\([^]]*\)\].*/\1/p" | head -n 1
}

has() {
  case "$all" in *"[fake:$1]"*) return 0;; esac
  return 1
}

# A counter in the run's scratch directory, which every call of a run shares: the n-th call of its kind gets n.
count() {
  file="/scratch/fake-count-$1"
  n=0
  [ -f "$file" ] && n=$(cat "$file")
  n=$((n + 1))
  printf '%s' "$n" > "$file"
  echo "$n"
}

hash() {
  printf '%s' "$1" | sha256sum | cut -d' ' -f1
}

# ---- behaviours that end the call before an answer ----
sleep_for=$(marker_value sleep)
[ -n "$sleep_for" ] && sleep "$sleep_for"

exit_code=$(marker_value exit)
if [ -n "$exit_code" ]; then
  echo "fake-claude: exiting with $exit_code on request" >&2
  exit "$exit_code"
fi

if has flood; then
  # Far beyond a 1 MiB output limit, in lines
  yes 'fake-claude flood line, longer than a few bytes, to fill the stream quickly' | head -c 3000000
  exit 0
fi

fail_until=$(marker_value fail-until)
if [ -n "$fail_until" ]; then
  n=$(count fail-until)
  if [ "$n" -lt "$fail_until" ]; then
    echo "fake-claude: call $n fails, the call $fail_until answers" >&2
    exit 1
  fi
fi

# ---- the answer ----
tool=no
if [ "$reason" = yes ]; then
  # A reasoning call of an agentic block: plan once, then declare the goal reached after the observation
  case "$prompt" in
    *"Observation from executing your action"*)
      answer="GOAL_STATUS: ACHIEVED
SUMMARY: the fake reached the goal" ;;
    *)
      answer="GOAL_STATUS: IN_PROGRESS
RATIONALE: the fake plans one action
ACTION: [fake:tool] do the one thing
SUMMARY: one action" ;;
  esac
elif has true; then
  answer="TRUE"
elif has false; then
  answer="FALSE"
elif [ -n "$(marker_value while)" ]; then
  n=$(count while)
  if [ "$n" -le "$(marker_value while)" ]; then answer="TRUE"; else answer="FALSE"; fi
elif has print-credential; then
  answer="the key is ${ANTHROPIC_API_KEY:-unset} and the token is ${CLAUDE_CODE_OAUTH_TOKEN:-unset}"
elif [ -n "$(marker_value connect)" ]; then
  # [fake:connect=HOST:PORT,HOST:PORT]: asks the proxy of the container for each target, when it has one, and tries
  # each directly as well; one line per attempt, with the first line of the answer or what went wrong
  answer=$(node -e '
const net = require("net");
const proxy = process.env.HTTPS_PROXY || "";
function ask(host, port, first) {
  return new Promise(done => {
    const socket = net.connect(port, host);
    let got = "";
    const end = text => { socket.destroy(); done(text); };
    socket.setTimeout(8000, () => end("timeout"));
    socket.on("connect", () => first ? socket.write(first) : end("connected"));
    socket.on("data", chunk => { got += chunk; if (got.includes("\r\n")) end(got.split("\r\n")[0]); });
    socket.on("error", e => end("error " + e.code));
    socket.on("close", () => done(got ? got.split("\r\n")[0] : "closed"));
  });
}
(async () => {
  const lines = ["proxy: " + (proxy || "none")];
  for (const target of process.argv[1].split(",")) {
    const at = target.lastIndexOf(":");
    if (proxy) {
      const u = new URL(proxy);
      lines.push("via proxy " + target + ": " + await ask(u.hostname, +u.port,
          "CONNECT " + target + " HTTP/1.1\r\nHost: " + target + "\r\n\r\n"));
    }
    lines.push("direct " + target + ": " + await ask(target.slice(0, at), +target.slice(at + 1), null));
  }
  console.log(lines.join("\n"));
})();' "$(marker_value connect)" 2>&1)
elif has write; then
  if (echo written > /workspace/fake-wrote.txt) 2>/dev/null; then answer="write: ok"; else answer="write: failed"; fi
elif [ -n "$(marker_value gate)" ]; then
  answer="checked by the fake
gate_status: $(marker_value gate)
gate_category: fake
gate_description: reported by the fake CLI"
else
  names=$(env | sed -n 's/^\(\(ANTHROPIC\|CLAUDE\|OPENAI\|GEMINI\|OPENROUTER\|TRACEWORKS\|DISABLE\)[A-Z0-9_]*\)=.*/\1/p' | sort | tr '\n' ' ')
  hashes=""
  for name in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN; do
    eval "value=\${$name:-}"
    [ -n "$value" ] && hashes="$hashes $name=$(hash "$value")"
  done
  answer="fake-claude answered
args:$args
env: $names
sha256:$hashes
cwd: $(pwd)
prompt: $prompt"
fi

case "$all" in *"[fake:tool]"*) tool=yes;; esac
printf '%s\n' '{"type":"system","subtype":"init","session_id":"fake-session","tools":[],"model":"fake-claude-1"}'
if [ "$tool" = yes ] && [ "$reason" = no ]; then
  printf '%s\n' '{"type":"assistant","message":{"model":"fake-claude-1","content":[{"type":"tool_use","id":"toolu_fake_1","name":"Read","input":{"file_path":"/workspace/hello.txt"}}]}}'
  printf '%s\n' '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_fake_1","content":"hello from the fake tool","is_error":false}]}}'
fi
printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","num_turns":1,"session_id":"fake-session","total_cost_usd":0.001,"usage":{"input_tokens":12,"output_tokens":7}}\n' "$(json "$answer")"

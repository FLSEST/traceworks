<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flsest</groupId>
        <artifactId>traceworks-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>traceworks-cli</artifactId>
    <packaging>jar</packaging>
    <name>Traceworks CLI</name>
    <description>Command line entry point: wires the core to the adapters.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.flsest</groupId>
            <artifactId>traceworks-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.flsest</groupId>
            <artifactId>traceworks-adapters</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.flsest</groupId>
            <artifactId>traceworks-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>traceworks</finalName>
        <resources>
            <!-- The license and the notice of the repository, carried by the jar: LICENSE (the GPL text) at its
                 root, NOTICE as META-INF/NOTICE. -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>NOTICE</include>
                </includes>
                <targetPath>META-INF</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- One runnable jar with Jackson and the two modules inside. Shading adds no dependency: the enforcer rule
                 in the parent still sees the same ones. The reduced pom, signature files and module descriptors are
                 left out, which keeps the build output free of warnings. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>traceworks.cli.main.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <!-- META-INF/NOTICE of the jar is the NOTICE of the repository, which begins with
                                     Traceworks' own notice and quotes the NOTICE files of the Jackson jars. Their own
                                     copies are left out, so the jar holds one. Jackson's META-INF/LICENSE (the Apache
                                     License, the same text in all three) stays; the GPL text is LICENSE at the root. -->
                                <filter>
                                    <artifact>com.fasterxml.jackson.core:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/NOTICE</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flsest</groupId>
        <artifactId>traceworks-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>traceworks-cli</artifactId>
    <packaging>jar</packaging>
    <name>Traceworks CLI</name>
    <description>Command line entry point: wires the core to the adapters.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.flsest</groupId>
            <artifactId>traceworks-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.flsest</groupId>
            <artifactId>traceworks-adapters</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.flsest</groupId>
            <artifactId>traceworks-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>traceworks</finalName>
        <plugins>
            <!-- The jar is made anew in every build. Shading replaces it with the jar that holds the other modules
                 too, so a build without clean would find it "up to date" whenever this module's own classes did not
                 change, and shade it again: the classes of core and adapters of the build before would win over the
                 new ones. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <!-- One runnable jar with Jackson and the two modules inside. Shading adds no dependency: the enforcer rule
                 in the parent still sees the same ones. The reduced pom, signature files and module descriptors are
                 left out, which keeps the build output free of warnings. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>traceworks.cli.main.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
